{
  "info": {
    "title": "Shipmozo Shipping API",
    "description": "REST API for order fulfillment, courier assignment, tracking, warehouses, NDR, and labels. All responses use `result` (`1` = success, `0` = failure), `message`, and `data`.\n\n**Base URL:** `https://shipping-api.com/app/api/v1` — do not add a trailing slash.\n\n**Auth:** Send `public-key` and `private-key` headers on every protected route, or obtain keys via `POST /login`.\n\n**Rate limits:** Shipmozo returns `x-ratelimit-limit` (500) and `x-ratelimit-remaining` on each response. Quota is **500 requests per 1-minute window** per API key; `remaining` drops with each call and **refreshes when the minute rolls over**.\n\n**Support:** munish@apporio.in",
    "version": "1.0.0",
    "contact": {
      "name": "Shipmozo API Support",
      "email": "munish@apporio.in"
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyPublic": {
        "type": "apiKey",
        "in": "header",
        "name": "public-key",
        "description": "API public key from panel profile or POST /login"
      },
      "ApiKeyPrivate": {
        "type": "apiKey",
        "in": "header",
        "name": "private-key",
        "description": "API private key — keep server-side only"
      }
    },
    "schemas": {
      "ShipmozoResponse": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "0",
              "1"
            ],
            "description": "1 = success, 0 = failure"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "description": "Panel username (email or phone)"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      }
    },
    "responses": {
      "ShipmozoUnauthorized": {
        "description": "Invalid or missing API keys",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ShipmozoResponse"
            },
            "example": {
              "result": "0",
              "message": "Invalid API credentials",
              "data": {}
            }
          }
        }
      },
      "ShipmozoValidationError": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "example": {
              "result": "0",
              "message": "Validation error",
              "data": {
                "error": "order_id is required"
              }
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            },
            "description": "Seconds to wait before retry"
          }
        },
        "content": {
          "application/json": {
            "example": {
              "result": "0",
              "message": "Rate limit exceeded",
              "data": {}
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyPublic": []
    },
    {
      "ApiKeyPrivate": []
    }
  ],
  "x-portal": {
    "rateLimitHeaders": {
      "title": "Response headers (from live API / Swagger)",
      "description": "Shipmozo documents rate limits via response headers, not only in PDF copy. Read these on every call:",
      "headers": [
        {
          "name": "x-ratelimit-limit",
          "example": "500",
          "meaning": "Max requests allowed in the current 1-minute window for your API key"
        },
        {
          "name": "x-ratelimit-remaining",
          "example": "(live value)",
          "meaning": "Requests left in the current window — decreases by 1 on each API call you make. You only see a new number on the next HTTP response (the page does not auto-update). After ~60s without traffic, the next call usually shows remaining closer to 500 again (sliding window)."
        }
      ],
      "note": "498 in tutorials means '2 calls used this minute' — not a fixed cap. Use Overview → Check now to read current headers."
    },
    "errorCodes": [
      {
        "id": "profile-under-verification",
        "result": "0",
        "typicalMessage": "Your profile is under verification",
        "when": "Seller KYC not completed or pending approval on Shipmozo panel",
        "action": "Finish verification in Shipmozo panel — keys may be valid while APIs stay blocked until approval"
      },
      {
        "id": "invalid-api-keys",
        "result": "0",
        "typicalMessage": "unauthorised user access / Invalid API credentials",
        "when": "Wrong, missing, or expired public-key / private-key",
        "action": "Re-login via POST /login or paste fresh keys from Panel → Profile"
      },
      {
        "id": "login-failed",
        "result": "0",
        "typicalMessage": "Invalid username or password (exact text unverified). Unknown email/phone may return \"Email or phone number is not registered.\"",
        "when": "POST /login with bad credentials",
        "action": "Verify panel username/password. Unknown accounts may return the unregistered email/phone message."
      },
      {
        "id": "order-not-found",
        "result": "0",
        "typicalMessage": "Order not found",
        "when": "Unknown order_id on assign, schedule, cancel, or get-detail",
        "action": "Push the order first; use Shipmozo internal order_id from push-order response"
      },
      {
        "id": "invalid-warehouse",
        "result": "0",
        "typicalMessage": "The selected warehouse id is invalid.",
        "when": "push-order with a warehouse_id that does not belong to the account",
        "action": "Call get-warehouses or create-warehouse and use a returned warehouse_id"
      },
      {
        "id": "auto-assign-not-setup",
        "result": "0",
        "typicalMessage": "please setup auto assign",
        "when": "auto-assign-order without panel Settings → Auto Assign configured",
        "action": "Enable Auto Assign rules in the Shipmozo panel, or use assign-courier instead"
      },
      {
        "id": "rate-limit",
        "result": "0",
        "typicalMessage": "Rate limit exceeded (or HTTP 429)",
        "when": "Too many calls in the shared 1-minute window",
        "action": "Pause and retry after ~60s"
      },
      {
        "id": "cors-trailing-slash",
        "result": "—",
        "typicalMessage": "Browser CORS error",
        "when": "Base URL ends with a trailing slash after /v1",
        "action": "Use the base URL without a trailing slash"
      }
    ],
