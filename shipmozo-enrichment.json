    "workflows": [
      {
        "id": "forward-standard",
        "title": "Forward shipment (manual courier)",
        "steps": [
          "POST /login\n(store public-key & private-key)",
          "POST /create-warehouse\n(only if no warehouse exists yet or have to use a new warehouse)",
          "GET /get-warehouses\n(list warehouses and confirm warehouse_id to use)",
          "POST /push-order\n(create order in panel)",
          "POST /rate-calculator\n(choose courier_id using Rate Calculator)",
          "POST /assign-courier\n(assign courier & get AWB Number)",
          "POST /schedule-pickup\n(If pickups_automatically_scheduled = NO)",
          "GET /get-order-label/{awb_number}\n(shipping label)",
          "GET /track-order?awb_number=…\n(tracking)"
        ]
      },
      {
        "id": "forward-auto",
        "title": "Forward shipment (auto-assign)",
        "steps": [
          "Configure Settings → Auto assign Rule in Shipmozo panel (add Rule)",
          "POST /push-order",
          "POST /auto-assign-order\n(AWB + courier in one call)",
          "GET /track-order / get-order-label as needed"
        ]
      },
      {
        "id": "return",
        "title": "Return order",
        "steps": [
          "GET /get-return-reason — pick return_reason_id",
          "POST /push-return-order",
          "POST /assign-courier or /auto-assign-order",
          "GET /track-order"
        ]
      },
      {
        "id": "cancel",
        "title": "Cancel before pickup",
        "steps": [
          "POST /cancel-order\n(order with order_id + awb_number) (Confirm result = 1)"
        ]
      },
      {
        "id": "ndr",
        "title": "NDR handling",
        "steps": [
          "GET /get-ndr-all — list non-delivery reports",
          "POST /ndr-action/{awb_number} — reattempt / RTO / etc."
        ]
      }
    ],
    "glossary": [
      {
        "term": "order_id",
        "meaning": "Your store's unique order ID; must match across push, assign, and cancel"
      },
      {
        "term": "reference_id",
        "meaning": "Shipmozo reference (often same as order_id). Note: live response bodies spell this field `refrence_id`; preserve that spelling when parsing responses."
      },
      {
        "term": "awb_number",
        "meaning": "Air Waybill tracking number from courier"
      },
      {
        "term": "warehouse_id",
        "meaning": "Pickup location ID from get-warehouses / create-warehouse"
      },
      {
        "term": "courier_id",
        "meaning": "Numeric ID from rate-calculator response"
      },
      {
        "term": "pickups_automatically_scheduled",
        "meaning": "YES = skip schedule-pickup; NO = call schedule-pickup after assign"
      },
      {
        "term": "NDR",
        "meaning": "Non-Delivery Report — failed delivery attempt"
      }
    ]
  },
  "operations": {
    "getApiInfo": {
      "security": [],
      "summary": "Check API health / version",
      "description": "Checks whether the Shipmozo API is currently reachable and responding. Requires no authentication — useful as a first connectivity check before setting up credentials.",
      "x-useCases": [
        "Health check before batch jobs",
        "Verify connectivity from new server"
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "example": {
                "result": "1",
                "message": "Success",
                "data": {
                  "version": "v1"
                }
              }
            }
          }
        }
      },
      "x-responseFields": [
        {
          "name": "result",
          "notes": "\"1\" means the API responded successfully."
        },
        {
          "name": "message",
          "notes": "Human-readable outcome."
        },
        {
          "name": "data",
          "notes": "Health/version details when provided by the API."
        }
      ],
      "x-errorExampleUnavailable": true
    },
    "Login": {
      "security": [],
      "summary": "Login & obtain API keys",
      "description": "Exchanges a Shipmozo panel username and password for the public_key / private_key pair used to authenticate all other requests. On success, data is an array: [{ name, public_key, private_key }] — note the array wrapping.",
      "x-useCases": [
        "Bootstrap integration — fetch public_key and private_key",
        "Rotate keys after password change"
      ],
      "x-errorExampleUnavailable": true,
      "x-responseFields": [
        {
          "name": "data[0].name",
          "notes": "Seller / account display name."
        },
        {
          "name": "data[0].public_key",
          "notes": "Send as the public-key header on later calls."
        },
        {
          "name": "data[0].private_key",
          "notes": "Send as the private-key header on later calls. Keep server-side only."
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "example": {
                "result": "1",
                "message": "Success",
                "data": [
                  {
                    "name": "Seller Name",
                    "public_key": "YOUR_PUBLIC_KEY",
                    "private_key": "YOUR_PRIVATE_KEY"
                  }
                ]
              }
            }
          }
        }
      },
      "x-docNotes": [
        "Success data is an array of one object — do not treat data as a plain object."
      ]
    },
