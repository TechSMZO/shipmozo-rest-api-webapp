  "rateCalculator": {
    "title": "Rate Calculator",
    "tip": "Tip: to check if a pincode pair is serviceable, call this endpoint — one or more couriers returned means the route is serviceable. An empty list or result \"0\" means the pincodes are not serviceable.",
    "fields": [
      {
        "field": "order_id",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Only if calculating for an existing order"
      },
      {
        "field": "pickup_pincode",
        "type": "number",
        "required": true,
        "values": "—",
        "notes": "The pickup pincode for this request."
      },
      {
        "field": "delivery_pincode",
        "type": "number",
        "required": true,
        "values": "—",
        "notes": "The delivery pincode for this request."
      },
      {
        "field": "payment_type",
        "type": "string",
        "required": true,
        "values": "PREPAID, COD",
        "notes": "PREPAID or COD."
      },
      {
        "field": "shipment_type",
        "type": "string",
        "required": true,
        "values": "FORWARD, RETURN",
        "notes": "FORWARD or RETURN as accepted by this endpoint."
      },
      {
        "field": "order_amount",
        "type": "number",
        "required": true,
        "values": "—",
        "notes": "The order amount for this request."
      },
      {
        "field": "type_of_package",
        "type": "string",
        "required": true,
        "values": "SPS, B2B, MPS",
        "notes": "Package type enum as accepted by Shipmozo (see accepted values)."
      },
      {
        "field": "rov_type",
        "type": "string",
        "required": true,
        "values": "ROV_OWNER, ROV_CARRIER",
        "notes": "Risk of value / insurance type when applicable."
      },
      {
        "field": "cod_amount",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Amount to collect for COD orders (required when payment_type is COD)."
      },
      {
        "field": "weight",
        "type": "number",
        "required": true,
        "values": "grams",
        "notes": "Shipment weight in grams."
      },
      {
        "field": "dimensions",
        "type": "array",
        "required": true,
        "values": "objects: no_of_box, length, width, height",
        "notes": "Array of boxes, e.g. [{\"no_of_box\":1,\"length\":10,\"width\":10,\"height\":10}] with length/width/height in cm."
      }
    ]
  },
