        "notes": "Digits only — no spaces or dashes"
      },
      {
        "field": "pickup_email",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "The pickup email for this request."
      },
      {
        "field": "pickup_address_line_one",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "The pickup address line one for this request."
      },
      {
        "field": "pickup_address_line_two",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "The pickup address line two for this request."
      },
      {
        "field": "pickup_pin_code",
        "type": "number",
        "required": true,
        "values": "—",
        "notes": "The pickup pin code for this request."
      },
      {
        "field": "pickup_city",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "The pickup city for this request."
      },
      {
        "field": "pickup_state",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "The pickup state for this request."
      },
      {
        "field": "product_detail",
        "type": "array",
        "required": true,
        "values": "same shape as Push Order",
        "notes": "Array of line items (name, sku, qty, price, etc.)."
      },
      {
        "field": "payment_type",
        "type": "string",
        "required": true,
        "values": "PREPAID, COD",
        "notes": "PREPAID or COD."
      },
      {
        "field": "weight",
        "type": "number",
        "required": true,
        "values": "kg",
        "notes": "Shipment weight in kg for return orders."
      },
      {
        "field": "length, width, height",
        "type": "number",
        "required": true,
        "values": "cm",
        "notes": "Accepted values: cm."
      },
      {
        "field": "warehouse_id",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Shipmozo warehouse id from get-warehouses / create-warehouse."
      },
      {
        "field": "return_reason_id",
        "type": "number",
        "required": true,
        "values": "from Get Return Reason",
        "notes": "Id from GET /get-return-reason."
      },
      {
        "field": "customer_request",
        "type": "string",
        "required": true,
        "values": "e.g. REFUND",
        "notes": "Accepted values not fully verified yet — use values from your Shipmozo panel"
      },
      {
        "field": "reason_comment",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "The reason comment for this request."
      }
    ]
  },
