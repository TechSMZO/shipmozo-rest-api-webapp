{
  "pushOrders": {
    "title": "Push Order",
    "fields": [
      {
        "field": "order_id",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "≤20 chars, alphanumeric only. Must be unique across retries."
      },
      {
        "field": "order_date",
        "type": "string",
        "required": true,
        "values": "YYYY-MM-DD",
        "notes": "YYYY-MM-DD. Must be within the last 6 months and no later than tomorrow (IST)."
      },
      {
        "field": "order_type",
        "type": "string",
        "required": false,
        "values": "ESSENTIALS, NON ESSENTIALS",
        "notes": "Goods category: ESSENTIALS or NON ESSENTIALS."
      },
      {
        "field": "consignee_name",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "Recipient full name."
      },
      {
        "field": "consignee_phone",
        "type": "number",
        "required": true,
        "values": "digits only",
        "notes": "Digits only — no spaces, dashes, or country code."
      },
      {
        "field": "consignee_alternate_phone",
        "type": "number",
        "required": false,
        "values": "digits only",
        "notes": "Digits only if provided; must differ from consignee_phone."
      },
      {
        "field": "consignee_email",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Recipient email address."
      },
      {
        "field": "consignee_address_line_one",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "Primary delivery street address."
      },
      {
        "field": "consignee_address_line_two",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Secondary address line (landmark, suite, etc.)."
      },
      {
        "field": "consignee_pin_code",
        "type": "number",
        "required": true,
        "values": "—",
        "notes": "Validated against Shipmozo's serviceable-pincode master — format-valid 6-digit codes not in that table are rejected."
      },
      {
        "field": "consignee_city",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "Delivery city."
      },
      {
        "field": "consignee_state",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "Delivery state."
      },
      {
        "field": "product_detail",
        "type": "array",
        "required": true,
        "values": "array of objects",
        "notes": "Array of line items. quantity ≤100,000; unit_price ≤10,000,000; discount ≤1,000,000; no limit on number of line items. Example shape includes name, sku_number, quantity, discount, hsn, unit_price, product_category."
      },
      {
        "field": "payment_type",
        "type": "string",
        "required": true,
        "values": "PREPAID, COD",
        "notes": "PREPAID or COD."
      },
      {
        "field": "cod_amount",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Required in practice when payment_type=COD"
      },
      {
        "field": "weight",
        "type": "number",
        "required": true,
        "values": "grams",
        "notes": "Shipment weight in grams. Caps by type_of_package: SPS ≤70 kg; MPS/B2B overall ≤3000 kg (see package-type table in endpoint notes)."
      },
      {
        "field": "length, width, height",
        "type": "number",
        "required": true,
        "values": "cm",
        "notes": "Accepted values: cm."
      },
      {
        "field": "warehouse_id",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "From Get Warehouses / Create Warehouse"
      },
      {
        "field": "gst_ewaybill_number, gstin_number",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "gstin_number must be exactly 15 characters when provided. gst_ewaybill_number required when business rules demand it."
      },
      {
        "field": "type_of_package",
        "type": "string",
        "required": true,
        "values": "SPS, MPS, B2B",
        "notes": "SPS: weight >0 ≤70kg, each L/W/H >0 ≤3000cm. MPS/B2B: overall weight >0 ≤3000kg; per-box no_of_box/L/W/H >0 ≤2000; per-box weight optional ≤70kg (MPS) or ≤400kg (B2B)."
      }
    ]
  },
  "pushReturnOrder": {
    "title": "Push Return Order",
    "fields": [
      {
        "field": "order_id",
        "type": "string",
        "required": true,
        "values": "≤20 alphanumeric",
        "notes": "Required, unique, ≤20 chars, alphanumeric"
      },
      {
        "field": "order_date",
        "type": "string",
        "required": true,
        "values": "YYYY-MM-DD",
        "notes": "Required"
      },
      {
        "field": "pickup_name",
        "type": "string",
        "required": true,
        "values": "letters/spaces/periods",
        "notes": "Letters, spaces, periods only — no digits or special characters"
      },
      {
        "field": "pickup_phone",
        "type": "string",
        "required": true,
        "values": "10-digit",
        "notes": "Required, 10 digits"
      },
      {
        "field": "pickup_alternate_phone",
        "type": "string",
        "required": false,
        "values": "10-digit",
        "notes": "Optional; must differ from pickup_phone"
      },
      {
        "field": "pickup_email",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Optional"
      },
      {
        "field": "pickup_address_line_one / pickup_address_line_two",
        "type": "string",
        "required": true,
        "values": "combined ≤200",
        "notes": "Combined ≤200 characters; some special characters restricted"
      },
      {
        "field": "pickup_pin_code",
        "type": "string",
        "required": true,
        "values": "must exist",
        "notes": "Required; must exist in pincode master"
      },
      {
        "field": "warehouse_id",
        "type": "string",
        "required": false,
        "values": "must exist",
        "notes": "Optional; must exist for the calling user"
      },
      {
        "field": "reason_comment",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Optional free-text reason"
      },
      {
        "field": "customer_request",
        "type": "string",
        "required": true,
        "values": "REFUND, EXCHANGE",
        "notes": "Send the string \"REFUND\" or \"EXCHANGE\" (case-sensitive). Do not send 1/2."
      },
      {
        "field": "return_reason_id",
        "type": "number",
        "required": true,
        "values": "from get-return-reason",
        "notes": "Must exist in return-reason list. Id→title mapping not yet available."
      },
      {
        "field": "weight / length / width / height",
        "type": "number",
        "required": true,
        "values": "numeric, ≠0",
        "notes": "Required, numeric, not zero — NO upper bound (unlike forward orders)."
      },
      {
        "field": "is_qc",
        "type": "string",
        "required": false,
        "values": "YES, NO",
        "notes": "Optional QC flag"
      },
      {
        "field": "payment_type",
        "type": "string",
        "required": true,
        "values": "PREPAID",
        "notes": "PREPAID only — COD not allowed for returns"
      },
      {
        "field": "product_detail.*.name",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "Line item name"
      },
      {
        "field": "product_detail.*.sku_number",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "SKU"
      },
      {
        "field": "product_detail.*.discount",
        "type": "number",
        "required": false,
        "values": "≤10,000",
        "notes": "Discount ≤10,000"
      },
      {
        "field": "product_detail.*.hsn",
        "type": "string",
        "required": false,
        "values": "≤8 chars",
        "notes": "HSN ≤8 characters — different from domestic Push Order's hsn limit"
      },
      {
        "field": "product_detail.*.quantity",
        "type": "number",
        "required": true,
        "values": "≤100,000",
        "notes": "Quantity ≤100,000"
      },
      {
        "field": "product_detail.*.unit_price",
        "type": "number",
        "required": true,
        "values": "≤1,000,000",
        "notes": "Unit price ≤1,000,000"
      },
      {
        "field": "product_detail.*.product_category",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Category"
      },
      {
        "field": "product_detail.*.brand",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Return-only field — not on domestic Push Order"
      },
      {
        "field": "product_detail.*.color",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Return-only field — not on domestic Push Order"
      }
    ]
  },
