{
  "pushOrders": {
    "title": "Push Order",
    "fields": [
      { "field": "order_id", "type": "string", "required": true, "values": "—", "notes": "Must match your own system's order ID" },
      { "field": "order_date", "type": "string", "required": true, "values": "YYYY-MM-DD", "notes": "" },
      { "field": "order_type", "type": "string", "required": false, "values": "ESSENTIALS, NON ESSENTIALS", "notes": "" },
      { "field": "consignee_name", "type": "string", "required": true, "values": "—", "notes": "" },
      { "field": "consignee_phone", "type": "number", "required": true, "values": "digits only", "notes": "" },
      { "field": "consignee_alternate_phone", "type": "number", "required": false, "values": "digits only", "notes": "" },
      { "field": "consignee_email", "type": "string", "required": false, "values": "—", "notes": "" },
      { "field": "consignee_address_line_one", "type": "string", "required": true, "values": "—", "notes": "" },
      { "field": "consignee_address_line_two", "type": "string", "required": false, "values": "—", "notes": "" },
      { "field": "consignee_pin_code", "type": "number", "required": true, "values": "—", "notes": "" },
      { "field": "consignee_city", "type": "string", "required": true, "values": "—", "notes": "" },
      { "field": "consignee_state", "type": "string", "required": true, "values": "—", "notes": "" },
      { "field": "product_detail", "type": "array", "required": true, "values": "objects: name, sku_number, quantity, discount, hsn, unit_price, product_category", "notes": "product_category is free text" },
      { "field": "payment_type", "type": "string", "required": true, "values": "PREPAID, COD", "notes": "" },
      { "field": "cod_amount", "type": "string", "required": false, "values": "—", "notes": "Required in practice when payment_type=COD" },
      { "field": "weight", "type": "number", "required": true, "values": "grams", "notes": "" },
      { "field": "length, width, height", "type": "number", "required": true, "values": "cm", "notes": "" },
      { "field": "warehouse_id", "type": "string", "required": true, "values": "—", "notes": "From Get Warehouses / Create Warehouse" },
      { "field": "gst_ewaybill_number, gstin_number", "type": "string", "required": false, "values": "—", "notes": "" }
    ]
  },
  "pushReturnOrder": {
    "title": "Push Return Order",
    "fields": [
      { "field": "order_id", "type": "string", "required": true, "values": "—", "notes": "" },
