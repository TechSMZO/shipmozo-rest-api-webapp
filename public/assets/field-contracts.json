{
  "pushOrders": {
    "title": "Push Order",
    "fields": [
      {
        "field": "order_id",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "Must match your own system's order ID; keep unique across retries"
      },
      {
        "field": "order_date",
        "type": "string",
        "required": true,
        "values": "YYYY-MM-DD",
        "notes": "Order date in YYYY-MM-DD."
      },
      {
        "field": "order_type",
        "type": "string",
        "required": false,
        "values": "ESSENTIALS, NON ESSENTIALS",
        "notes": "Goods category: ESSENTIALS or NON ESSENTIALS."
      },
      {
        "field": "consignee_name",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "Recipient full name."
      },
      {
        "field": "consignee_phone",
        "type": "number",
        "required": true,
        "values": "digits only",
        "notes": "Digits only — no spaces, dashes, or country code."
      },
      {
        "field": "consignee_alternate_phone",
        "type": "number",
        "required": false,
        "values": "digits only",
        "notes": "Digits only if provided; no country code."
      },
      {
        "field": "consignee_email",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Recipient email address."
      },
      {
        "field": "consignee_address_line_one",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "Primary delivery street address."
      },
      {
        "field": "consignee_address_line_two",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Secondary address line (landmark, suite, etc.)."
      },
      {
        "field": "consignee_pin_code",
        "type": "number",
        "required": true,
        "values": "—",
        "notes": "Delivery pincode."
      },
      {
        "field": "consignee_city",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "Delivery city."
      },
      {
        "field": "consignee_state",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "Delivery state."
      },
      {
        "field": "product_detail",
        "type": "array",
        "required": true,
        "values": "array of objects",
        "notes": "Array of line items. Example: [{\"name\":\"T-Shirt\",\"sku_number\":\"SKU1\",\"quantity\":1,\"discount\":\"\",\"hsn\":\"6109\",\"unit_price\":499,\"product_category\":\"Apparel\"}]"
      },
      {
        "field": "payment_type",
        "type": "string",
        "required": true,
        "values": "PREPAID, COD",
        "notes": "PREPAID or COD."
      },
      {
        "field": "cod_amount",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "Required in practice when payment_type=COD"
      },
      {
        "field": "weight",
        "type": "number",
        "required": true,
        "values": "grams",
        "notes": "Shipment weight in grams."
      },
      {
        "field": "length, width, height",
        "type": "number",
        "required": true,
        "values": "cm",
        "notes": "Accepted values: cm."
      },
      {
        "field": "warehouse_id",
        "type": "string",
        "required": true,
        "values": "—",
        "notes": "From Get Warehouses / Create Warehouse"
      },
      {
        "field": "gst_ewaybill_number, gstin_number",
        "type": "string",
        "required": false,
        "values": "—",
        "notes": "The gst ewaybill number, gstin number for this request."
      }
    ]
  },
  "pushReturnOrder": {
    "title": "Push Return Order",
    "fields": [
      {
        "field": "order_id",
