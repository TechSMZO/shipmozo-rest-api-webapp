      { "field": "pickup_state", "type": "string", "required": true, "values": "—", "notes": "" },
      { "field": "product_detail", "type": "array", "required": true, "values": "same shape as Push Order", "notes": "" },
      { "field": "payment_type", "type": "string", "required": true, "values": "PREPAID, COD", "notes": "" },
      { "field": "weight", "type": "number", "required": true, "values": "kg", "notes": "Differs from Push Order (grams)" },
      { "field": "length, width, height", "type": "number", "required": true, "values": "cm", "notes": "" },
      { "field": "warehouse_id", "type": "string", "required": false, "values": "—", "notes": "" },
